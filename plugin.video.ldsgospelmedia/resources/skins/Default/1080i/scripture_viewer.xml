<?xml version="1.0" encoding="UTF-8"?>
<!--
  The scripture reading window.

  Designed to read like a printed page rather than a Kodi dialog: a parchment
  ground, warm ink, a narrow measure with wide margins, and nothing on screen that
  is not the text.

  A note on type. Add-on windows resolve font *names* from whichever skin the user
  is running, so a serif face bundled here could not be referenced reliably - it
  would silently fall back and look broken on some skins. The reading feel is
  therefore carried by the things that are ours to control: the paper, the ink
  colour, a measure of roughly 90 characters, and generous leading. Font tags are
  the standard ones every skin defines.

  Control ids
    100  title
    200  reference line
    300  body textbox
    400  scrollbar bound to the textbox
    500  footer hint
-->
<window type="window">
    <defaultcontrol always="true">300</defaultcontrol>
    <allowoverlay>no</allowoverlay>
    <coordinates>
        <system>1</system>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>

    <controls>

        <!-- Paper -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>parchment.png</texture>
            <aspectratio>scale</aspectratio>
        </control>

        <!-- Title -->
        <control type="label" id="100">
            <left>300</left>
            <top>64</top>
            <width>1320</width>
            <height>54</height>
            <font>font24</font>
            <textcolor>FF3B2C18</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <label></label>
            <wrapmultiline>false</wrapmultiline>
        </control>

        <!-- Reference / date line -->
        <control type="label" id="200">
            <left>300</left>
            <top>120</top>
            <width>1320</width>
            <height>34</height>
            <font>font13</font>
            <textcolor>FF8A6D4B</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <label></label>
        </control>

        <!-- Rule beneath the heading -->
        <control type="image">
            <left>760</left>
            <top>168</top>
            <width>400</width>
            <height>2</height>
            <texture>parchment.png</texture>
            <colordiffuse>66000000</colordiffuse>
        </control>

        <!--
          Body. The measure is deliberately narrower than the window: 1240px at
          font14 lands near 90 characters a line, which is the range printed
          scripture sits in. Full-width text would be markedly harder to read.
        -->
        <control type="textbox" id="300">
            <left>340</left>
            <top>206</top>
            <width>1240</width>
            <height>782</height>
            <font>font14</font>
            <textcolor>FF33281A</textcolor>
            <align>left</align>
            <autoscroll>false</autoscroll>
            <pagecontrol>400</pagecontrol>
        </control>

        <control type="scrollbar" id="400">
            <left>1616</left>
            <top>206</top>
            <width>12</width>
            <height>782</height>
            <texturesliderbackground colordiffuse="22000000">parchment.png</texturesliderbackground>
            <texturesliderbar colordiffuse="55000000">parchment.png</texturesliderbar>
            <textureslidernib colordiffuse="88000000">parchment.png</textureslidernib>
            <showonepage>false</showonepage>
            <orientation>vertical</orientation>
        </control>

        <!-- Navigation hint -->
        <control type="label" id="500">
            <left>300</left>
            <top>1002</top>
            <width>1320</width>
            <height>30</height>
            <font>font12</font>
            <textcolor>FF9C8A6E</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <label></label>
        </control>

    </controls>
</window>
